#! /usr/bin/env bash

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

cmake_version='3.28.6'
cmake_system='macos-universal'
cmake_dir="cmake-${cmake_version}-${cmake_system}"
cmake_url="https://github.com/Kitware/CMake/releases/download/v${cmake_version}/${cmake_dir}.tar.gz"

_exec curl --output cmake.tgz --location "${cmake_url}"
_exec tar xf cmake.tgz
_exec rm cmake.tgz
_exec mv "${cmake_dir}/CMake.app/Contents" /cmake
_exec rm -r "${cmake_dir}"
_exec ln -s /cmake/bin/cmake /usr/bin/cmake

sevenzip_version='26.04'
sevenzip_url="https://sourceforge.net/projects/sevenzip/files/7-Zip/${sevenzip_version}/7z${sevenzip_version//./}-mac.tar.xz"

_exec curl --output /sevenzip.txz --location "${sevenzip_url}"
_exec mkdir /sevenzip
_exec tar -C /sevenzip -xf /sevenzip.txz
_exec rm /sevenzip.txz
_exec ln -s /sevenzip/7zz /usr/bin/7z

# This requires 7z to already be in PATH.
_exec tools/macos-extract-clt-dmg.pl local/xcode/Command_Line_Tools_for_Xcode_14.3.1.dmg /tmp/clt
_exec rm -rfv /Library/Developer/CommandLineTools
_exec mv /tmp/clt/root/Library/Developer/CommandLineTools /Library/Developer/
_exec rm -rf /tmp/clt
_exec tools/macos-replace-clt.sh
_exec tools/macos-set-clt-env.sh

_exec touch /.dockerenv
